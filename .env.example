# Copy to .env.local for development. Never commit real values.
# Supabase project settings > API. The anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Do NOT add the service_role key to the web app. Admin tasks use the Supabase dashboard or scripts.

# Tests only: a local PostgreSQL 16 superuser URL used to build throwaway test databases.
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?host=/var/run/postgresql
